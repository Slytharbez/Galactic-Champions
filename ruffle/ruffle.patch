diff --git a/desktop/src/ben10.rs b/desktop/src/ben10.rs
new file mode 100644
index 00000000..eb6e4ad3
--- /dev/null
+++ b/desktop/src/ben10.rs
@@ -0,0 +1,64 @@
+//! Ben 10 Campeones Galacticos: este Ruffle abre el juego solo.
+//!
+//! Si el .exe se abre sin argumentos y junto a el esta `game\game.swf`,
+//! arma los argumentos que antes ponia el lanzador: ventana 850x550 sin menu,
+//! links externos bloqueados, URL fija (para que el guardado no dependa de la
+//! carpeta) y guardado/config/cache dentro de `saves\`.
+//! Opcion: `opciones.ini` junto al .exe con la linea `pantalla_completa=1`.
+
+use std::ffi::OsString;
+use std::path::Path;
+
+pub const TITLE: &str = "Ben 10 Campeones Galácticos";
+
+const SPOOF_URL: &str = "https://galacticchampions.local/game.swf";
+
+pub fn args() -> Vec<OsString> {
+    let args: Vec<OsString> = std::env::args_os().collect();
+    if args.len() > 1 {
+        return args;
+    }
+    let Some(root) = std::env::current_exe()
+        .ok()
+        .and_then(|exe| exe.parent().map(Path::to_path_buf))
+    else {
+        return args;
+    };
+    let swf = root.join("game").join("game.swf");
+    if !swf.is_file() {
+        return args;
+    }
+
+    let saves = root.join("saves");
+    let config = saves.join("_ruffle-config");
+    let cache = saves.join("_ruffle-cache");
+    for dir in [&saves, &config, &cache] {
+        let _ = std::fs::create_dir_all(dir);
+    }
+
+    let fullscreen = std::fs::read_to_string(root.join("opciones.ini"))
+        .map(|ini| {
+            ini.lines().any(|line| {
+                line.replace(' ', "")
+                    .trim()
+                    .eq_ignore_ascii_case("pantalla_completa=1")
+            })
+        })
+        .unwrap_or(false);
+
+    let mut out: Vec<OsString> = vec![args[0].clone(), "--no-gui".into()];
+    if fullscreen {
+        out.push("--fullscreen".into());
+    } else {
+        out.extend(["--width", "850", "--height", "550"].map(OsString::from));
+    }
+    out.extend(["--open-url-mode", "deny", "--spoof-url", SPOOF_URL].map(OsString::from));
+    out.push("--save-directory".into());
+    out.push(saves.into_os_string());
+    out.push("--config".into());
+    out.push(config.into_os_string());
+    out.push("--cache-directory".into());
+    out.push(cache.into_os_string());
+    out.push(swf.into_os_string());
+    out
+}
